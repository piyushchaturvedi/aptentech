# AptenTech — production environment
#
# Copy this to BOTH apps, then fill it in:
#
#   cp .env.production.example apps/api/.env
#   cp .env.production.example apps/web/.env.local
#
# The two files share several values and MUST agree on them — API_SERVICE_TOKEN and
# REVALIDATE_SECRET in particular. A mismatch is not a startup error: the site simply renders
# every page empty, or CMS edits never reach it. `npm run preflight` checks for exactly that.
#
# Never commit a filled-in copy. `.gitignore` already covers .env and .env.local.

NODE_ENV=production

# ---------------------------------------------------------------- database

# Atlas: mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
# Self-hosted: mongodb://user:password@host:27017/?authSource=admin
MONGODB_URI=
MONGODB_DB_NAME=aptentech

# ---------------------------------------------------------------- addresses

# The canonical public host. Every canonical URL, sitemap entry and social image is built
# from this, so it must be the address people actually visit — apex or www, https, no
# trailing slash.
PUBLIC_SITE_URL=https://aptentech.com
NEXT_PUBLIC_SITE_URL=https://aptentech.com

# Where the Next.js app runs, as the API sees it. Used for CORS and for the admin links in
# notification emails.
WEB_ORIGIN=https://aptentech.com

# Where the API runs, as the Next.js app reaches it — server to server, so this is usually
# a private address or localhost on the same host, never the public internet.
API_BASE_URL=http://127.0.0.1:4000/api/v1

# Where the API posts cache invalidations after a CMS write.
REVALIDATE_URL=https://aptentech.com/api/revalidate

PORT=4000

# ---------------------------------------------------------------- secrets
#
# Generate all three, and paste the SAME values into both files:
#
#   node -e "const c=require('crypto');console.log('API_SERVICE_TOKEN='+c.randomBytes(32).toString('base64url'));console.log('SESSION_SECRET='+c.randomBytes(32).toString('base64url'));console.log('REVALIDATE_SECRET='+c.randomBytes(24).toString('base64url'))"

# The Next.js server presents this on every API call. It never reaches a browser.
API_SERVICE_TOKEN=

# Signs admin session cookies. Rotating it signs everyone out.
SESSION_SECRET=

# Signs the cache-invalidation webhook the API fires at Next.js.
REVALIDATE_SECRET=

SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=30

# Set only if the admin runs on a different subdomain to the site.
# COOKIE_DOMAIN=.aptentech.com

# ---------------------------------------------------------------- proxy
#
# true behind nginx, a load balancer or any CDN that terminates TLS. Without it every
# visitor appears to come from the proxy's own address, so rate limiting counts them as one
# client and lead attribution records the wrong IP.
TRUST_PROXY=true

# ---------------------------------------------------------------- media

# s3    — required on any host with an ephemeral filesystem (containers, most PaaS)
# local — acceptable only on a server with a persistent disk, and needs ALLOW_LOCAL_MEDIA
MEDIA_DRIVER=s3

AWS_REGION=us-east-1
S3_BUCKET=
# Set when serving through CloudFront; otherwise the bucket URL is used.
S3_PUBLIC_BASE_URL=

# Omit both on EC2/ECS and use an instance role instead — a role cannot leak in a backup.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# Uploads survive a redeploy on this host. Only set this if that is actually true.
# ALLOW_LOCAL_MEDIA=true

# ---------------------------------------------------------------- email

# ses  — Amazon SES, using AWS_REGION and the credentials or role above
# smtp — any SMTP relay; needs the four SMTP_ values below
# log  — sends nothing; needs ALLOW_NO_EMAIL to boot in production
EMAIL_DRIVER=smtp

# The envelope sender. The provider must have verified this address or its domain.
EMAIL_FROM=no-reply@aptentech.com

# Used to build Message-ID headers. Threading a client's reply back to its lead depends on
# this staying stable — change it only if the domain itself changes.
EMAIL_MESSAGE_ID_DOMAIN=aptentech.com

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Launching without mail. Leads are still saved and visible in the admin; nobody is notified.
# ALLOW_NO_EMAIL=true

# Shared secret the mail provider presents when posting a client's reply to
# POST /api/v1/email/inbound. Without it that endpoint refuses every call.
INBOUND_WEBHOOK_SECRET=

# ---------------------------------------------------------------- logging

# info in production; debug is noisy and can put request detail in the log.
LOG_LEVEL=info
