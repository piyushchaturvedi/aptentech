# AptenTech — environment reference
#
# Every variable the project reads, with safe example values. Real values never belong in this
# file; it is committed, and .gitignore covers .env and .env.local precisely so the filled-in
# copies are not.
#
# LOCAL DEVELOPMENT
#   cp .env.example .env
#   node -e "const c=require('crypto');console.log(c.randomBytes(32).toString('base64url'))"
#   ...paste into the three secrets below, then:
#   cp .env apps/api/.env && cp .env apps/web/.env.local
#
# PRODUCTION
#   Do not edit by hand. One command derives everything from the site URL, generates any
#   missing secret, and writes both files:
#     SITE_URL=http://your-server-ip node scripts/prod-env.js
#   Only MONGODB_URI and the SMTP credentials cannot be generated.

# ------------------------------------------------------------------ runtime

# development | production | test
NODE_ENV=development

# The Node API's port. nginx proxies to it on the loopback; it is never exposed publicly.
PORT=4000

# fatal | error | warn | info | debug | trace — info in production; debug can log request detail.
LOG_LEVEL=info

# true when anything terminates TLS in front of the app (nginx, a load balancer, a CDN).
# Without it every visitor appears to come from the proxy, so rate limiting counts them as one
# client and each lead records the proxy's address.
TRUST_PROXY=false

# ------------------------------------------------------------------ database

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=aptentech

# ------------------------------------------------------------------ addresses
#
# The scheme here is load-bearing, not cosmetic. `https://` makes the session cookie `secure`
# and turns on the CSP's upgrade-insecure-requests; setting it before a certificate exists
# makes the admin impossible to sign in to and every asset fail to load.

# The canonical public address — every canonical URL, sitemap entry and social image is built
# from it.
PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The single origin the API accepts cross-origin requests from. Never `*`: the admin sends
# credentials, and a wildcard is invalid with them.
WEB_ORIGIN=http://localhost:3000

# Where the Next.js server reaches the API. Server to server, so this stays on the loopback in
# production — the browser never calls the API directly.
API_BASE_URL=http://127.0.0.1:4000/api/v1

# Where the API posts cache invalidations after a CMS write.
REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate

# ------------------------------------------------------------------ secrets
#
# Generate each with:
#   node -e "const c=require('crypto');console.log(c.randomBytes(32).toString('base64url'))"
#
# API_SERVICE_TOKEN and REVALIDATE_SECRET must be IDENTICAL in both apps' files. A mismatch is
# not a startup error — the site renders every page empty, or CMS edits never reach it.

# The token the Next.js server presents on every API call. Never reaches a browser.
API_SERVICE_TOKEN=change-me-at-least-24-characters-long

# Signs admin session cookies. Rotating it signs everyone out.
SESSION_SECRET=change-me-at-least-32-characters-long

# Signs the cache-invalidation webhook the API fires at Next.js.
REVALIDATE_SECRET=change-me-at-least-16-characters

SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=30

# Only when the admin runs on a different subdomain to the site.
# COOKIE_DOMAIN=.example.com

# ------------------------------------------------------------------ media

# local | s3
# local keeps uploads on the server's own disk. In production that needs ALLOW_LOCAL_MEDIA,
# because on a host with an ephemeral filesystem every upload is lost on the next deploy.
MEDIA_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# Confirms this server has a persistent disk.
# ALLOW_LOCAL_MEDIA=true

# Only when MEDIA_DRIVER=s3. Not required for the current deployment.
# AWS_REGION=us-east-1
# S3_BUCKET=
# S3_PUBLIC_BASE_URL=
# On EC2, prefer an instance role over keys — a role cannot leak in a backup.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------ email

# ses | smtp | log
# log records the message and reports success without contacting anyone. In production that
# needs ALLOW_NO_EMAIL, because it discards every notification while the site keeps saying the
# enquiry was sent.
EMAIL_DRIVER=log

# The envelope sender. The provider must have verified this address or its domain.
EMAIL_FROM=no-reply@example.com

# Used to build Message-ID headers. Threading a client's reply back to its lead depends on this
# staying stable — change it only if the domain changes.
EMAIL_MESSAGE_ID_DOMAIN=example.com

# Required when EMAIL_DRIVER=smtp. Port 587 with SMTP_SECURE=false is STARTTLS, which is what
# most providers want; 465 with true is implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Launch without mail. Leads are still saved and visible in the admin; nobody is notified.
# ALLOW_NO_EMAIL=true

# Shared secret the mail provider presents when posting a client's reply to
# POST /api/v1/email/inbound. Without it that endpoint refuses every call.
INBOUND_WEBHOOK_SECRET=change-me-16-characters-minimum

# ------------------------------------------------------------------ seeding
#
# Where the 25 original HTML files live. The content seed reads them. Defaults to the parent
# directory of the repository.
# SOURCE_HTML_DIR=/var/www/aptentech
