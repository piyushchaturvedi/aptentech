# ============================================================
#  AptenTech platform — environment configuration
#  Copy to .env and fill in. Never commit the real .env.
# ============================================================

NODE_ENV=development

# ---------- Node.js API ----------
PORT=4000

# MongoDB. Local for development; MongoDB Atlas (SRV URI) for production.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=aptentech

# Origin of the Next.js app. The only browser origin allowed to call the API.
WEB_ORIGIN=http://localhost:3000
PUBLIC_SITE_URL=https://aptentech.com

# Shared secret the Next.js SERVER presents to the API. Never exposed to a browser.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_SERVICE_TOKEN=change-me-dev-service-token-0123456789

# Signs admin session cookies. Rotating this signs everyone out.
SESSION_SECRET=change-me-dev-session-secret-0123456789abcdef
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=30
# COOKIE_DOMAIN=.aptentech.com

# HMAC for the cache-revalidation webhook the API calls on Next.js after a content change.
REVALIDATE_SECRET=change-me-dev-revalidate-secret
REVALIDATE_URL=http://localhost:3000/api/revalidate/

# ---------- Media ----------
# local  = write to disk, served from the API at /uploads (development only)
# s3     = production. Requires S3_BUCKET.
MEDIA_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

AWS_REGION=ap-south-1
# S3_BUCKET=aptentech-media
# Serve through CloudFront in production rather than the raw S3 endpoint.
# S3_PUBLIC_BASE_URL=https://cdn.aptentech.com
# Omit these on EC2/Lightsail and use an IAM role instead of long-lived keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------- Email ----------
# Every mail credential lives here and nowhere else. The CMS owns who mail goes to and what
# it says; it must never own the provider keys, because the admin is reachable by more people
# than the server configuration is.
#
# log  = record the message and report success without contacting anyone (development only)
# ses  = Amazon SES. Uses AWS_REGION and the same credentials/role as media.
# smtp = any SMTP relay. Requires SMTP_HOST, SMTP_USER and SMTP_PASSWORD.
EMAIL_DRIVER=log

# The envelope sender. Must be an address the provider has verified, or mail is rejected.
EMAIL_FROM=no-reply@aptentech.com

# Used to mint Message-ID headers. Threading a client's reply back to its lead depends on
# this staying stable, so change it only alongside a domain move.
EMAIL_MESSAGE_ID_DOMAIN=aptentech.com

# SMTP only.
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Shared secret the mail provider presents when posting an inbound reply to
# POST /api/v1/email/inbound. Without it that endpoint refuses every call, which is the
# safe default: it is unauthenticated otherwise and anyone could write into a client thread.
# INBOUND_WEBHOOK_SECRET=

# ---------- Operations ----------
LOG_LEVEL=info
# Set to true only when actually behind a proxy/load balancer, otherwise a client can
# spoof X-Forwarded-For and bypass every per-IP rate limit.
TRUST_PROXY=false

# ---------- Next.js web app ----------
# Server-side only. Must NOT be prefixed NEXT_PUBLIC_ — that would ship it to the browser.
API_BASE_URL=http://localhost:4000/api/v1
# Canonical host. Keep this as the production domain in EVERY environment: canonical
# tags, Open Graph URLs, the sitemap and structured data must all point at the live
# site, otherwise a staging deploy can publish canonicals pointing at staging.
NEXT_PUBLIC_SITE_URL=https://aptentech.com

# ---------- First admin (used by `npm run create-admin`) ----------
# Leave ADMIN_PASSWORD unset to have a strong one generated and printed once.
# ADMIN_EMAIL=you@aptentech.com
# ADMIN_NAME=Your Name
# ADMIN_ROLE=SUPER_ADMIN
# ADMIN_PASSWORD=

# Where the 25 original HTML files live (used by the seed).
# SOURCE_HTML_DIR=D:/Arpit/AptenTech
